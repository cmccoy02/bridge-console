{
  "name": "bridge-console",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Bridge console: GitHub App, token broker and run ledger for Bridge",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "setup:github-app": "node scripts/create-github-app.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@fontsource-variable/overpass": "5.3.0",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.17",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
