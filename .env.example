# Copy to .env.local for local development. In production set these in Vercel.

# Public URL of this console. Used for sign-in redirects, run links and as the
# expected audience of GitHub Actions OIDC tokens.
BRIDGE_PUBLIC_URL=http://localhost:3000

# Postgres connection string (Supabase: use the transaction pooler URL, port 6543).
# Leave empty locally to use an embedded database stored in .data/pglite.
DATABASE_URL=

# openssl rand -base64 32
SESSION_SECRET=
# openssl rand -base64 32   (encrypts Slack webhook URLs at rest)
ENCRYPTION_KEY=

# From `npm run setup:github-app` (writes .env.github-app).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# PEM contents, or the PEM base64-encoded on one line.
GITHUB_APP_PRIVATE_KEY=

# Workflows allowed to request push tokens and upload runs (comma-separated prefixes
# of the OIDC job_workflow_ref claim).
BRIDGE_TRUSTED_WORKFLOWS=cmccoy02/bridge-cli/.github/workflows/bridge.yml@

# Optional. Defaults to the origin of BRIDGE_PUBLIC_URL.
BRIDGE_OIDC_AUDIENCE=

# Local only: adds a "Continue as developer" sign-in that skips GitHub.
BRIDGE_DEV_LOGIN=1
